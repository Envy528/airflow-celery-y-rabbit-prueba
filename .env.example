# Copia este archivo como .env en CADA máquina y rellénalo:  cp .env.example .env
# El .env real NO se sube a git.

# ===== Compartido (debe ser IGUAL en todas las máquinas) =====
# Genera con: docker run --rm apache/airflow:3.1.5 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
# Genera con: docker run --rm apache/airflow:3.1.5 python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=
RABBITMQ_DEFAULT_USER=rabbit
RABBITMQ_DEFAULT_PASS=rabbit

# ===== Solo maestro (los workers lo ignoran) =====
AIRFLOW_UID=50000
# Cada cuántos SEGUNDOS revisa cambios en los DAGs (60 = 1 minuto)
AIRFLOW__DAG_PROCESSOR__BUNDLE_REFRESH_CHECK_INTERVAL=60
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ===== Solo workers (el maestro lo ignora) =====
# IP privada del maestro (en el portátil: ipconfig -> Dirección IPv4)
MASTER_IP=
# Colas que atiende este worker, separadas por coma
WORKER_QUEUES=default